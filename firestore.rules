rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor');
      allow write: if false; // only admin can create users
    }
    match /plate_events/{eventId} {
      allow create: if request.auth != null && request.resource.data.operatorId == request.auth.uid;
      allow read: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor' || (request.auth.uid == resource.data.operatorId && resource.data.timestamp > timestamp.date(1970,1,1)));
      allow update,delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }
  }
}